# Local environment files are gitignored.
# Copy an app example, then put real values only in the untracked copy:
#   apps/api/.env.example    -> apps/api/.env
#   apps/mobile/.env.example -> apps/mobile/.env
#
# Placeholders below are safe to commit. Do not commit passwords, tokens,
# API keys, or production credentials.

# apps/api/.env
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/luminatech?schema=public
PORT=3000

# apps/mobile/.env
EXPO_PUBLIC_API_URL=http://localhost:3000
