{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "types": ["vitest/globals", "node"],
    // Injected classes are constructor types, but Nest still needs their runtime imports.
    "verbatimModuleSyntax": false,
    // Nest assigns injected properties outside the constructor.
    "strictPropertyInitialization": false
  }
}
